[Unit]
Description=Anonymizing overlay network for TCP
After=network-online.target
Wants=network-online.target
ConditionPathIsReadWrite=/var/tor

[Service]
Type=notify
DynamicUser=yes
SupplementaryGroups=tor
ReadWritePaths=/var/tor
ExecStart=@bindir@/tor -f /etc/tor/torrc
#ExecStart=@bindir@/tor -f /etc/tor/torrc.relay
Restart=on-failure
RestartSec=5
RuntimeDirectory=tor
RuntimeDirectoryMode=0700

[Install]
WantedBy = multi-user.target
