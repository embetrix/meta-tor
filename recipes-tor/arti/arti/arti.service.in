[Unit]
Description=Anonymizing overlay network for TCP (Arti-Rust)
After=network-online.target
Wants=network-online.target
Conflicts=tor.service

[Service]
Type=notify
DynamicUser=yes

StateDirectory=arti
StateDirectoryMode=0700
CacheDirectory=arti
CacheDirectoryMode=0700
RuntimeDirectory=arti
RuntimeDirectoryMode=0700

Environment=HOME=/var/lib/arti

ExecStart=@bindir@/arti proxy -c /etc/arti/arti.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target