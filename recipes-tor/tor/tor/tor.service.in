[Unit]
Description=Anonymizing overlay network for TCP
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
DynamicUser=yes
User=tor
Group=tor
StateDirectory=tor
StateDirectoryMode=0700
BindPaths=/var/lib/tor:/var/tor
ExecStart=@bindir@/tor -f /etc/tor/torrc
#ExecStart=@bindir@/tor -f /etc/tor/torrc.relay
RuntimeDirectory=tor
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5

[Install]
WantedBy = multi-user.target
